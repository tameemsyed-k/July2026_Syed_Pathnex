# Ansible — Setup Nginx with Reverse Proxy
- name: Configure Nginx Reverse Proxy
  hosts: all
  become: yes
  tags:
    - nginx
    - proxy
  tasks:
    - name: Ensure nginx is installed
      yum:
        name: nginx
        state: present

    - name: Deploy reverse proxy template
      template:
        src: reverse-proxy.conf.j2
        dest: /etc/nginx/conf.d/reverse-proxy.conf
      notify: Restart Nginx

    - name: Ensure Nginx is running and enabled
      service:
        name: nginx
        state: restarted
        enabled: yes

  handlers:
    - name: Restart Nginx
      service:
        name: nginx
        state: restarted

# Terraform — S3 Bucket with Versioning & Logging
resource "aws_s3_bucket" "pathnex_data_bucket" {
  bucket = "pathnex-data-bucket-2026"

  versioning {
    enabled = true
  }

  logging {
    target_bucket = "pathnex-access-logs-bucket"
    target_prefix = "access-logs/"
  }

  lifecycle {
    prevent_destroy = false
  }

  tags = {
    Environment = "devops-lab"
    ManagedBy   = "terraform"
  }
}

# Kubernetes — Ingress with Nginx Controller
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: pathnex-ingress-v2
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    kubernetes.io/ingress.class: nginx
spec:
  rules:
    - host: pathnex.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: pathnex-service
                port:
                  number: 80

